+        const cleanQ = q.replace(/[^a-z0-9]/g, "");
+        const title = (item.title || "").toLowerCase();
+        const cleanTitle = title.replace(/[^a-z0-9]/g, "");
+
+        if (cleanTitle === cleanQ) return 1000;
+        if (title.startsWith(q) || (cleanQ.length >= 2 && cleanTitle.startsWith(cleanQ))) return 800;
+        const words = title.split(/\s+/);
+        if (words.some(w => w.startsWith(q) || (cleanQ.length >= 2 && w.replace(/[^a-z0-9]/g, "").startsWith(cleanQ)))) return 600;
+        if (title.includes(q) || (cleanQ.length >= 2 && cleanTitle.includes(cleanQ))) return 400;
+        if ((item.shortcut || "").toLowerCase().includes(q)) return 300;
+        if ((item.category || "").toLowerCase().startsWith(q)) return 200;
+        if ((item.subtitle || "").toLowerCase().includes(q)) return 100;
+        return 10;
